// ╔══════════════════════════════════════════════════════════════════╗
// ║  firestore.rules — PRODUCTION v2.1                              ║
// ║  ✅ commissions collection added                                ║
// ║  ✅ Setup doc PUBLIC read                                       ║
// ║  ✅ Dual role support (string + array)                          ║
// ║  ✅ Serial counter atomic transactions                          ║
// ╚══════════════════════════════════════════════════════════════════╝

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════

    function isAuthed() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userDoc().get('role', '') : '';
    }

    function userRoles() {
      return userDocExists()
        ? (userDoc().get('roles', [userDoc().get('role', '')]))
        : [];
    }

    function hasRole(role) {
      return userDocExists() && (
        userRole() == role ||
        (role in userRoles())
      );
    }

    function isSuperAdmin() {
      return isAuthed() && userDocExists() && (
        hasRole('superAdmin') ||
        hasRole('superadmin') ||
        hasRole('super_admin')
      );
    }

    function isAdmin() {
      return isAuthed() && userDocExists() && (
        isSuperAdmin() ||
        hasRole('admin')
      );
    }

    function isManager() {
      return isAuthed() && userDocExists() && (
        isAdmin() ||
        hasRole('manager')
      );
    }

    function isBiller() {
      return isAuthed() && userDocExists() && hasRole('biller');
    }

    function isCashier() {
      return isAuthed() && userDocExists() && hasRole('cashier');
    }

    function isStoreStaff() {
      return isBiller() || isCashier() || isManager() || isAdmin();
    }

    function defaultTenantId() {
      return 'aone';
    }

    function tenantAllowed(data) {
      return !('tenantId' in data)
        || data.tenantId == defaultTenantId()
        || isSuperAdmin();
    }

    function hasValidSerial() {
      return request.resource.data.serialNo is string
             && request.resource.data.serialNo.size() > 0
             && request.resource.data.serialNo != '----';
    }

    // ═══════════════════════════════════════════════════════
    // SETTINGS — Setup doc PUBLIC READ
    // ═══════════════════════════════════════════════════════
    match /settings/{settingId} {
      allow read: if settingId == 'setup' || isAuthed();
      allow create, update: if isSuperAdmin()
        || (settingId == 'appConfig' && isAdmin())
        || (settingId == 'dualMode' && isAdmin())
        || (settingId == 'setup' && isAuthed())
        || (settingId == 'backupSchedule' && isAdmin());
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // BACKUPS — Admin-only metadata + encrypted payloads
    // backups/{id}           → audit log / metadata
    // systemBackups/{id}     → full JSON or chunk manifest
    // systemBackups/{id}/chunks/{n} → large backup chunks
    // ═══════════════════════════════════════════════════════
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /systemBackups/{backupId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /chunks/{chunkId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    match /archiveBatches/{batchId} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /archive_records/{recordId} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /backup_notifications/{notificationId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // ORDERS (BILLS)
    // ═══════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasValidSerial();
      allow update: if isAuthed() && (
        isStoreStaff() ||
        isAdmin() ||
        request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false)
      );
      // Permanent delete from Bills Control — Super Admin only
      allow delete: if isSuperAdmin();
    }

    // Pre-aggregated daily sales — written by Cloud Function only
    match /dailySummaries/{summaryId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /bills/{billId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // STORES
    // ═══════════════════════════════════════════════════════
    match /stores/{storeId} {
      allow read: if isAuthed();
      allow create: if isAdmin();
      allow update: if isAuthed() && (
        !('lastSerialNumber' in request.resource.data) ||
        request.resource.data.lastSerialNumber >= resource.data.lastSerialNumber
      );
      allow delete: if isSuperAdmin();

      // Cross-device paid-keys sync (cashier queue dedup)
      match /meta/{metaId} {
        allow read: if isAuthed();
        allow write: if isAuthed();
      }
    }

    // ═══════════════════════════════════════════════════════
    // SERIAL COUNTERS — Atomic transactions
    // ═══════════════════════════════════════════════════════
    match /serialCounters/{counterId} {
      allow read: if isAuthed();
      allow write: if isAuthed();
    }

    match /serialLocks/{lockId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isAuthed() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.email is string &&
          resource.data.email == request.auth.token.email)
      );
      allow update: if isAuthed() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      allow create: if isAuthed() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // Email verification links — Admin/Super Admin send; user completes via public link
    match /email_verify_tokens/{tokenId} {
      allow create: if isAdmin();
      allow read: if true;
      allow update: if
        resource.data.verified == false &&
        request.resource.data.verified == true &&
        request.resource.data.email == resource.data.email &&
        request.time.toMillis() < resource.data.expiresAt;
      allow delete: if isAdmin();
    }

    // Legacy OTP collection (deprecated)
    match /user_email_otps/{otpId} {
      allow read, write: if isAdmin();
    }

    // Deleted user tombstones — reclaim email when Firebase Auth orphan remains
    match /user_tombstones/{tombId} {
      allow read, write, delete: if isSuperAdmin();
    }

    // Firebase Trigger Email extension queue
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /sync_ops/{opId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // CUSTOMERS
    // ═══════════════════════════════════════════════════════
    match /customers/{custId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && tenantAllowed(request.resource.data);
      allow update: if isAuthed() && tenantAllowed(request.resource.data);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // ACTIVITY LOGS — Immutable
    // ═══════════════════════════════════════════════════════
    match /activityLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /billerStallAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isBiller() || isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /cashierActions/{actionId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{lid} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /superAdminActivityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // NOTIFICATIONS — Cashier flags, alerts
    // ═══════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // DELETED BILLS
    // ═══════════════════════════════════════════════════════
    match /deletedBills/{billId} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // SYSTEM
    // ═══════════════════════════════════════════════════════
    match /system/{docId} {
      allow read: if isAuthed();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // PAYMENTS
    // ═══════════════════════════════════════════════════════
    match /payments/{payId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // EXPENSES
    // ═══════════════════════════════════════════════════════
    match /expenses/{expId} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // RETURNS
    // ═══════════════════════════════════════════════════════
    match /returns/{retId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // HELD BILLS
    // ═══════════════════════════════════════════════════════
    match /heldBills/{hid} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ═══════════════════════════════════════════════════════
    // AUDIT / LEGACY LOGS (auditLogs rules above — superAdmin purge)
    // ═══════════════════════════════════════════════════════
    match /clearedData/{did} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // FRAUD + SHIFTS + CASH
    // ═══════════════════════════════════════════════════════
    match /fraudAlerts/{fid} {
      allow read: if isAdmin();
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payment ↔ Bill reconciliation (independent matching records)
    match /payment_matches/{matchId} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    // Fraud review queue — payment/bill mismatches & suspicious activity
    match /fraud_reviews/{reviewId} {
      allow read: if isManager();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /shifts/{shid} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if false;
    }

    match /cashTransactions/{tid} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if false;
      allow delete: if false;
    }

    match /approvalRequests/{rid} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isManager();
      allow delete: if false;
    }

    match /superApprovalRequests/{rid} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /managerApprovedOrders/{oid} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if false;
    }

    match /managerCancelledOrders/{oid} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // GLOBAL COUNTERS
    // ═══════════════════════════════════════════════════════
    match /globalCounters/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ═══════════════════════════════════════════════════════
    // ✅ NEW: COMMISSIONS — Salesperson commission tracking
    // commissions/{agentId}                → summary doc
    // commissions/{agentId}/snapshots/{id} → history log
    // ═══════════════════════════════════════════════════════
    match /commissions/{agentId} {
      // Managers, admins, superadmin can read
      allow read: if isManager();

      // SuperAdmin creates agent commission docs
      allow create: if isSuperAdmin();

      // SuperAdmin updates (rate change, toggle, soft-delete)
      allow update: if isSuperAdmin();

      // Hard delete only superadmin
      allow delete: if isSuperAdmin();

      // ── Snapshots sub-collection (immutable history) ──
      match /snapshots/{snapshotId} {
        // Managers and above can read history
        allow read: if isManager();

        // SuperAdmin writes snapshot entries
        allow create: if isSuperAdmin();

        // Snapshots never change once written
        allow update: if false;
        allow delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════
    // DEVICES — Terminal/PWA checkout session management
    // ═══════════════════════════════════════════════════════
    match /devices/{deviceId} {
      allow read: if isAuthed();
      allow create, update: if isAdmin() || (
        isAuthed() &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // DEFAULT DENY — Must be last
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}